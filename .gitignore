scratch/
scratchpad/
tmp/

# Keep the runtime mount points in the tree so a fresh clone has the directories
# a bind mount expects, without publishing anything written into them.
!data/adapter-memory/.gitkeep
!data/adapter-memory/.gitignore

# Rendered animation output. The renderer in animation/src reproduces all of it,
# so the media itself does not need to live in the repository.
# The README embeds these two, so they belong in the repository.

animation/demo/
animation/tour/
animation/extended/
animation/out/
animation/